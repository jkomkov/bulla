{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphstandard.com/spec/action-receipt-v0.4.schema.json",
  "title": "ActionReceipt v0.4 draft occurrence binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "canonicalization", "kind", "action", "diagnostic_ref",
    "evidence_refs", "anchor_ref", "mandate", "remedy", "retention", "stake",
    "conventions", "signature", "occurrence", "authorization", "event_id",
    "claimed_at", "producer", "hashes"
  ],
  "properties": {
    "schema_version": {"const": "0.4"},
    "canonicalization": {"const": "bulla-jcs-int/1"},
    "kind": {"const": "action_receipt"},
    "action": {
      "type": "object",
      "required": ["type", "subject"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "subject": {"type": "object"}
      },
      "additionalProperties": true
    },
    "diagnostic_ref": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["reference", "not_applicable", "deferred"]},
        "ref": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "hash", "grounding"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "hash": {"$ref": "#/$defs/hash"},
          "grounding": {
            "enum": ["self_asserted", "counterparty_signed", "third_party_anchored", "execution_verified"]
          }
        },
        "additionalProperties": false
      }
    },
    "anchor_ref": {"type": "object"},
    "mandate": {"$ref": "#/$defs/mandate"},
    "remedy": {"oneOf": [{"$ref": "#/$defs/recourse"}, {"type": "object", "maxProperties": 0}]},
    "retention": {"$ref": "#/$defs/retention"},
    "stake": {"type": "null"},
    "conventions": {"type": "array", "items": {"$ref": "#/$defs/convention"}},
    "signature": {"oneOf": [{"$ref": "#/$defs/contentProof"}, {"type": "null"}]},
    "occurrence": {"oneOf": [{"$ref": "#/$defs/occurrenceProof"}, {"type": "null"}]},
    "authorization": {"oneOf": [{"$ref": "#/$defs/authorizationProof"}, {"type": "null"}]},
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "claimed_at": {"type": "string", "minLength": 1},
    "producer": {"type": "object"},
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "event", "attestation", "log_leaf"],
      "properties": {
        "content": {"$ref": "#/$defs/hash"},
        "event": {"$ref": "#/$defs/hash"},
        "attestation": {"$ref": "#/$defs/hash"},
        "log_leaf": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "signature": {"$ref": "#/$defs/contentProof"},
        "occurrence": {"$ref": "#/$defs/occurrenceProof"},
        "authorization": {"$ref": "#/$defs/authorizationProof"}
      }
    },
    {
      "properties": {
        "signature": {"type": "null"},
        "occurrence": {"type": "null"},
        "authorization": {"type": "null"}
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "purpose", "issuer", "verificationMethod", "proofValue"],
      "properties": {
        "type": {"const": "bulla/ed25519-2026"},
        "purpose": {"enum": ["content", "occurrence", "authorization", "delegation-grant"]},
        "issuer": {"type": "string", "minLength": 1},
        "verificationMethod": {"type": "string", "minLength": 1},
        "proofValue": {"type": "string", "minLength": 1}
      }
    },
    "contentProof": {
      "allOf": [{"$ref": "#/$defs/proof"}, {"properties": {"purpose": {"const": "content"}}}]
    },
    "occurrenceProof": {
      "allOf": [{"$ref": "#/$defs/proof"}, {"properties": {"purpose": {"const": "occurrence"}}}]
    },
    "authorizationProof": {
      "allOf": [{"$ref": "#/$defs/proof"}, {"properties": {"purpose": {"const": "authorization"}}}]
    },
    "grantProof": {
      "allOf": [{"$ref": "#/$defs/proof"}, {"properties": {"purpose": {"const": "delegation-grant"}}}]
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "value"],
      "properties": {"domain": {"type": "string", "minLength": 1}, "value": {"type": "integer", "minimum": 0}}
    },
    "delegationGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["grantor", "grantee", "principal", "parent", "policy_digest", "scope_digest", "proof"],
      "properties": {
        "grantor": {"type": "string", "minLength": 1},
        "grantee": {"type": "string", "minLength": 1},
        "principal": {"type": "string", "minLength": 1},
        "parent": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "policy_digest": {"$ref": "#/$defs/hash"},
        "scope_digest": {"$ref": "#/$defs/hash"},
        "not_before": {"$ref": "#/$defs/checkpoint"},
        "not_after": {"$ref": "#/$defs/checkpoint"},
        "proof": {"$ref": "#/$defs/grantProof"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["principal", "policy", "delegation"],
      "properties": {
        "principal": {"type": "string", "minLength": 1},
        "policy": {"type": "string", "minLength": 1},
        "delegation": {"type": "array", "maxItems": 8, "items": {"oneOf": [
          {"type": "string", "minLength": 1}, {"$ref": "#/$defs/delegationGrant"}
        ]}}
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["scope"],
      "properties": {
        "scope": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
        "expires": {"type": ["string", "null"]},
        "rollback_window": {"type": ["string", "null"]}
      }
    },
    "mandate": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "deed_schema": {"enum": ["0.2", "0.3"]},
        "authority": {"$ref": "#/$defs/authority"},
        "bounds": {"$ref": "#/$defs/bounds"}
      }
    },
    "forum": {
      "type": "object", "additionalProperties": false,
      "required": ["log_endpoint", "trusted_root_ref"],
      "properties": {
        "log_endpoint": {"type": "string", "minLength": 1},
        "trusted_root_ref": {"type": "string", "minLength": 1}
      }
    },
    "remedyItem": {
      "type": "object", "additionalProperties": false,
      "required": ["rung", "verifier", "anchor"],
      "properties": {
        "rung": {"enum": ["recompute", "challenge", "cure", "revert", "slash", "escalate"]},
        "verifier": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1}
      }
    },
    "recourse": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge_window", "forum", "remedies"],
      "properties": {
        "challenge_window": {"type": "string", "minLength": 1},
        "forum": {"$ref": "#/$defs/forum"},
        "remedies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/remedyItem"}}
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "record": {"enum": ["authority-permanent", "operational", "personal-expiring"]},
        "disclosure": {"enum": ["public", "party", "auditor"]}
      }
    },
    "convention": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "scope", "kind", "definition_hash"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "kind": {"enum": ["executable", "semantic"]},
        "definition": {},
        "definition_hash": {"$ref": "#/$defs/hash"},
        "forum": {"$ref": "#/$defs/forum"}
      }
    }
  }
}
