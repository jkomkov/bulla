{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphstandard.com/schema/bulla-inference-clearing-comprehension-response-0.2.json",
  "title": "Authenticated retained inference evidence comprehension response",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "content", "reader_proof", "coordinator_proof"],
  "properties": {
    "profile": {"const": "bulla.inference-clearing-comprehension-response/0.2"},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "participant_id", "reader_key", "slot", "participant_role", "eligibility", "gate_open_sha256", "browser_interactions", "first_responses", "first_response_hashes", "rubric", "assistance", "terminal_reproduction", "corrections", "limitations"],
      "properties": {
        "attempt_id": {"minLength": 1, "type": "string"},
        "participant_id": {"pattern": "^reader-[0-9]{2}$", "type": "string"},
        "reader_key": {"pattern": "^did:key:z", "type": "string"},
        "slot": {"pattern": "^(developer-[123]|decision-maker-[12])$", "type": "string"},
        "participant_role": {"enum": ["DEVELOPER", "TECHNICAL_DECISION_MAKER"]},
        "eligibility": {"type": "object", "additionalProperties": false, "required": ["identity_commitment", "no_prior_bulla", "no_prior_glyph", "no_prior_res_agentica", "no_pr_review", "no_implementation_involvement"], "properties": {"identity_commitment": {"$ref": "#/$defs/hash"}, "no_prior_bulla": {"const": true}, "no_prior_glyph": {"const": true}, "no_prior_res_agentica": {"const": true}, "no_pr_review": {"const": true}, "no_implementation_involvement": {"const": true}}},
        "gate_open_sha256": {"$ref": "#/$defs/hash"},
        "browser_interactions": {"type": "object", "additionalProperties": false, "required": ["provider_exit_recheck", "receipt_boundary_challenge"], "properties": {"provider_exit_recheck": {"enum": ["COMPLETED", "FAILED"]}, "receipt_boundary_challenge": {"enum": ["COMPLETED", "FAILED"]}}},
        "first_responses": {"$ref": "#/$defs/responses"},
        "first_response_hashes": {"$ref": "#/$defs/hashes"},
        "rubric": {"$ref": "#/$defs/rubric"},
        "assistance": {"items": {"type": "object", "additionalProperties": false, "required": ["category", "description"], "properties": {"category": {"enum": ["NAVIGATION", "ACCESSIBILITY"]}, "description": {"minLength": 1, "type": "string"}}}, "type": "array"},
        "terminal_reproduction": {"type": "object", "additionalProperties": false, "required": ["required", "status", "duration_seconds"], "properties": {"required": {"type": "boolean"}, "status": {"enum": ["COMPLETED", "FAILED", "NOT_REQUIRED"]}, "duration_seconds": {"minimum": 0, "type": ["number", "null"]}}},
        "corrections": {"items": {"type": "object", "additionalProperties": false, "required": ["question_id", "text"], "properties": {"question_id": {"$ref": "#/$defs/question"}, "text": {"minLength": 1, "type": "string"}}}, "type": "array"},
        "limitations": {"items": {"minLength": 1, "type": "string"}, "type": "array"}
      },
      "allOf": [{"if": {"properties": {"slot": {"const": "developer-1"}}}, "then": {"properties": {"terminal_reproduction": {"properties": {"required": {"const": true}, "status": {"const": "COMPLETED"}, "duration_seconds": {"maximum": 180, "type": "number"}}}}}}]
    },
    "reader_proof": {"$ref": "#/$defs/proof"},
    "coordinator_proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {
    "hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "proof": {"type": "object", "additionalProperties": false, "required": ["type", "purpose", "issuer", "verificationMethod", "proofValue"], "properties": {"type": {"const": "bulla/ed25519-2026"}, "purpose": {"const": "content"}, "issuer": {"pattern": "^did:key:z", "type": "string"}, "verificationMethod": {"pattern": "^did:key:z", "type": "string"}, "proofValue": {"minLength": 1, "type": "string"}}},
    "question": {"enum": ["same_output", "retained_evidence", "provider_contact", "relation_reproduction", "historical_provider_execution", "answer_correctness", "buyer_policy_decision", "integrity_coverage_completeness"]},
    "responses": {"type": "object", "additionalProperties": false, "required": ["same_output", "retained_evidence", "provider_contact", "relation_reproduction", "historical_provider_execution", "answer_correctness", "buyer_policy_decision", "integrity_coverage_completeness"], "properties": {"same_output": {"type": "string"}, "retained_evidence": {"type": "string"}, "provider_contact": {"type": "string"}, "relation_reproduction": {"type": "string"}, "historical_provider_execution": {"type": "string"}, "answer_correctness": {"type": "string"}, "buyer_policy_decision": {"type": "string"}, "integrity_coverage_completeness": {"type": "string"}}},
    "hashes": {"type": "object", "additionalProperties": false, "patternProperties": {"^(same_output|retained_evidence|provider_contact|relation_reproduction|historical_provider_execution|answer_correctness|buyer_policy_decision|integrity_coverage_completeness)$": {"$ref": "#/$defs/hash"}}, "minProperties": 8, "maxProperties": 8},
    "rubric": {"type": "object", "additionalProperties": false, "patternProperties": {"^(same_output|retained_evidence|provider_contact|relation_reproduction|historical_provider_execution|answer_correctness|buyer_policy_decision|integrity_coverage_completeness)$": {"enum": ["PASS", "FAIL"]}}, "minProperties": 8, "maxProperties": 8}
  }
}
