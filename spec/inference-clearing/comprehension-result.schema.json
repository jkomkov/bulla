{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphstandard.com/schema/bulla-inference-clearing-comprehension-result-0.1.json",
  "title": "Derived recheckable inference comprehension result",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "status", "protocol_sha256", "gate_open_sha256", "attempt_manifest_sha256", "attempt_history", "participant_evidence", "measures", "limitations"],
  "properties": {
    "profile": {"const": "bulla.inference-clearing-comprehension-result/0.1"},
    "status": {"enum": ["ESTABLISHED", "NOT_ESTABLISHED", "BLOCKED"]},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "gate_open_sha256": {"$ref": "#/$defs/hash"},
    "attempt_manifest_sha256": {"$ref": "#/$defs/hash"},
    "attempt_history": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "status", "scope", "dimensions", "participant_evidence"], "properties": {"attempt_id": {"minLength": 1, "type": "string"}, "status": {"enum": ["ESTABLISHED", "NOT_ESTABLISHED", "BLOCKED"]}, "scope": {"enum": ["ALL_DIMENSIONS", "FAILED_DIMENSIONS_ONLY"]}, "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "participant_evidence": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/hash"}}}}},
    "participant_evidence": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "measures": {"type": "object", "additionalProperties": false, "required": ["participants", "browser_story_passes", "role_handoff_passes", "all_distinctions_passes", "answer_correctness_boundary_passes", "funds_movement_boundary_passes", "terminal_reproduction_seconds"], "properties": {"participants": {"minimum": 3, "maximum": 5, "type": "integer"}, "browser_story_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "role_handoff_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "all_distinctions_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "answer_correctness_boundary_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "funds_movement_boundary_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "terminal_reproduction_seconds": {"minimum": 0, "type": ["number", "null"]}}},
    "limitations": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "ESTABLISHED"}}}, "then": {"properties": {"participant_evidence": {"minItems": 5}}}}],
  "$defs": {"hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}}
}
