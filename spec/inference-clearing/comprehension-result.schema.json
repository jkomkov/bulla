{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphstandard.com/schema/bulla-inference-clearing-comprehension-result-0.2.json",
  "title": "Derived retained inference evidence comprehension result",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "status", "protocol_sha256", "gate_open_sha256", "attempt_manifest_sha256", "attempt_history", "participant_evidence", "measures", "limitations"],
  "properties": {
    "profile": {"const": "bulla.inference-clearing-comprehension-result/0.2"},
    "status": {"enum": ["ESTABLISHED", "NOT_ESTABLISHED", "BLOCKED"]},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "gate_open_sha256": {"$ref": "#/$defs/hash"},
    "attempt_manifest_sha256": {"$ref": "#/$defs/hash"},
    "attempt_history": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "status", "scope", "dimensions", "participant_evidence"], "properties": {"attempt_id": {"minLength": 1, "type": "string"}, "status": {"enum": ["ESTABLISHED", "NOT_ESTABLISHED"]}, "scope": {"const": "ALL_DIMENSIONS"}, "dimensions": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}}, "participant_evidence": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/hash"}}}}},
    "participant_evidence": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "measures": {"type": "object", "additionalProperties": false, "required": ["participants", "browser_interaction_passes", "all_distinctions_passes", "historical_execution_boundary_passes", "answer_correctness_boundary_passes", "provider_contact_passes", "terminal_reproduction_seconds"], "properties": {"participants": {"const": 5}, "browser_interaction_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "all_distinctions_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "historical_execution_boundary_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "answer_correctness_boundary_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "provider_contact_passes": {"minimum": 0, "maximum": 5, "type": "integer"}, "terminal_reproduction_seconds": {"minimum": 0, "type": ["number", "null"]}}},
    "limitations": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "ESTABLISHED"}}}, "then": {"properties": {"participant_evidence": {"minItems": 5}}}}],
  "$defs": {"hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}}
}
