{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphstandard.com/schema/bulla-inference-clearing-comprehension-attempt-manifest-0.1.json",
  "title": "Authenticated comprehension attempt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "content", "proof"],
  "properties": {
    "profile": {"const": "bulla.inference-clearing-comprehension-attempt-manifest/0.1"},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_open_sha256", "attempts"],
      "properties": {
        "gate_open_sha256": {"$ref": "#/$defs/hash"},
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attempt_id", "scope", "dimensions", "response_refs"],
            "properties": {
              "attempt_id": {"minLength": 1, "type": "string"},
              "scope": {"enum": ["ALL_DIMENSIONS", "FAILED_DIMENSIONS_ONLY"]},
              "dimensions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["browser_story_without_help", "role_handoff", "all_eight_distinctions", "answer_correctness", "funds_movement", "terminal_reproduction"]}
              },
              "response_refs": {
                "type": "array",
                "minItems": 3,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {"pattern": "^responses/[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+\\.json$", "type": "string"},
                    "sha256": {"$ref": "#/$defs/hash"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {
    "hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "purpose", "issuer", "verificationMethod", "proofValue"],
      "properties": {
        "type": {"const": "bulla/ed25519-2026"},
        "purpose": {"const": "content"},
        "issuer": {"pattern": "^did:key:z", "type": "string"},
        "verificationMethod": {"pattern": "^did:key:z", "type": "string"},
        "proofValue": {"minLength": 1, "type": "string"}
      }
    }
  }
}
