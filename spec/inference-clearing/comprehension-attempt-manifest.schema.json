{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphstandard.com/schema/bulla-inference-clearing-comprehension-attempt-manifest-0.2.json",
  "title": "Authenticated comprehension attempt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "content", "proof"],
  "properties": {
    "profile": {"const": "bulla.inference-clearing-comprehension-attempt-manifest/0.2"},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_open_sha256", "attempts"],
      "properties": {
        "gate_open_sha256": {"$ref": "#/$defs/hash"},
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attempt_id", "scope", "dimensions", "response_refs"],
            "properties": {
              "attempt_id": {"minLength": 1, "type": "string"},
              "scope": {"const": "ALL_DIMENSIONS"},
              "dimensions": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {"enum": ["browser_interactions", "all_eight_distinctions", "historical_execution", "answer_correctness", "provider_contact", "terminal_reproduction"]}
              },
              "response_refs": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {"pattern": "^responses/attempt-1/reader-[0-9]{2}\\.json$", "type": "string"},
                    "sha256": {"$ref": "#/$defs/hash"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {
    "hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "proof": {"type": "object", "additionalProperties": false, "required": ["type", "purpose", "issuer", "verificationMethod", "proofValue"], "properties": {"type": {"const": "bulla/ed25519-2026"}, "purpose": {"const": "content"}, "issuer": {"pattern": "^did:key:z", "type": "string"}, "verificationMethod": {"pattern": "^did:key:z", "type": "string"}, "proofValue": {"minLength": 1, "type": "string"}}}
  }
}
