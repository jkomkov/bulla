{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphstandard.com/schemas/inference-clearing/clearing-core-0.1.json",
  "title": "Bulla inference-clearing core 0.1 experimental",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile", "transaction_id", "revision", "provider_kind", "comparison_group",
    "role_issuers", "term_root", "ordered_receipts", "artifacts"
  ],
  "properties": {
    "profile": {"const": "bulla.inference-clearing/0.1-experimental"},
    "transaction_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "revision": {"const": 1},
    "provider_kind": {"enum": ["OPAQUE", "REPRODUCIBLE"]},
    "comparison_group": {"$ref": "#/$defs/hash"},
    "role_issuers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buyer", "router", "provider_opaque", "provider_reproducible", "receiver", "witness", "relier", "settlement_authority", "rail_observer", "guarantor", "publisher"],
      "properties": {
        "buyer": {"type": "string", "minLength": 1},
        "router": {"type": "string", "minLength": 1},
        "provider_opaque": {"type": "string", "minLength": 1},
        "provider_reproducible": {"type": "string", "minLength": 1},
        "receiver": {"type": "string", "minLength": 1},
        "witness": {"type": "string", "minLength": 1},
        "relier": {"type": "string", "minLength": 1},
        "settlement_authority": {"type": "string", "minLength": 1},
        "rail_observer": {"type": "string", "minLength": 1},
        "guarantor": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1}
      }
    },
    "term_root": {"$ref": "#/$defs/hash"},
    "ordered_receipts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_type", "role", "path", "event", "attestation"],
        "properties": {
          "action_type": {"enum": ["inference.order", "inference.route", "inference.accept", "inference.delivery", "assurance.collateral.bind", "assurance.guarantee.issue", "inference.coverage.checkpoint", "bulla.rely", "assurance.settlement.authorize", "rail.settlement.report"]},
          "role": {"enum": ["buyer", "router", "provider", "receiver", "rail_observer", "guarantor", "relier", "settlement_authority"]},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
          "event": {"$ref": "#/$defs/hash"},
          "attestation": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 62,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "byte_length", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
          "media_type": {"enum": ["application/json", "application/octet-stream"]},
          "byte_length": {"type": "integer", "minimum": 0, "maximum": 262144},
          "sha256": {"$ref": "#/$defs/hash"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
