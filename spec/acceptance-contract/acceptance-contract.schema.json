{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphstandard.com/schemas/bulla.acceptance-contract-0.1.json",
  "title": "Bulla Acceptance Contract 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile", "contract_id", "revision", "semantic_epoch", "authority_epoch",
    "policy_authority_ref", "transaction_id", "terms", "term_root",
    "contemplated_consequence", "requirements", "receiver_coverage_requirement",
    "correction_policy", "challenge_policy", "evidence_requests",
    "authorization_policy", "execution_policy"
  ],
  "properties": {
    "profile": {"const": "bulla.acceptance-contract/0.1-experimental"},
    "contract_id": {"type": "string", "minLength": 1},
    "revision": {"$ref": "#/$defs/safeInteger"},
    "semantic_epoch": {"$ref": "#/$defs/safeInteger"},
    "authority_epoch": {"$ref": "#/$defs/safeInteger"},
    "policy_authority_ref": {"type": "string", "minLength": 1},
    "transaction_id": {"type": "string", "minLength": 1},
    "terms": {
      "type": "object", "additionalProperties": false,
      "required": ["build_hash", "environment", "claim", "consequence"],
      "properties": {
        "build_hash": {"$ref": "#/$defs/hash"},
        "environment": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "consequence": {"const": "release.promote"}
      }
    },
    "term_root": {"$ref": "#/$defs/hash"},
    "contemplated_consequence": {"type": "object"},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "receiver_coverage_requirement": {"type": "object"},
    "correction_policy": {"type": "object"},
    "challenge_policy": {"type": "object"},
    "evidence_requests": {"type": "array", "items": {"type": "object"}},
    "authorization_policy": {"const": {"eligible_state": "NOT_ISSUED"}},
    "execution_policy": {"const": {"eligible_state": "NOT_ATTEMPTED"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
